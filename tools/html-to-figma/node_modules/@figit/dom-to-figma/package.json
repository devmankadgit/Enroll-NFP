{
  "name": "@figit/dom-to-figma",
  "version": "0.2.4",
  "description": "Convert any DOM tree to a Figma clipboard payload, in the browser.",
  "license": "MIT",
  "author": "Figit <https://figit.design>",
  "homepage": "https://github.com/figitdesign/web-to-figma#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figitdesign/web-to-figma.git",
    "directory": "packages/dom-to-figma"
  },
  "bugs": {
    "url": "https://github.com/figitdesign/web-to-figma/issues"
  },
  "keywords": [
    "figma",
    "dom",
    "html-to-figma",
    "dom-to-figma",
    "design-tools",
    "clipboard",
    "converter",
    "browser"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/figma.d.mts",
      "import": "./dist/figma.mjs"
    }
  },
  "main": "./dist/figma.mjs",
  "types": "./dist/figma.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "colorjs.io": "^0.6.1",
    "fontkit": "^2.0.4",
    "@figit/fig-kiwi": "0.2.0"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^25.6.0",
    "@vitest/browser-playwright": "^4.1.5",
    "happy-dom": "^20.9.0",
    "playwright": "^1.50.0",
    "tsdown": "^0.21.0",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "biome check",
    "oracle:outbox": "tsx ./scripts/oracle-outbox.ts"
  }
}